Screen {
    background: #0b0f14;
    color: #d7dde5;
    layout: vertical;
}

#brand {
    height: auto;
    padding: 1 2;
    background: #111821;
    color: #7dd3fc;
    text-style: bold;
    border-bottom: solid #243244;
}

#conversation {
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #334155;
    scrollbar-background: #111821;
}

.message, .tool-card, .thinking-card {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.message {
    padding: 1 2;
}

.user-message {
    background: transparent;
    padding: 0;
}

.user-divider {
    color: #243244;
    margin: 0;
}

.user-text {
    background: #1a1f2e;
    padding: 1 2;
}

.assistant-message {
    margin-right: 5;
    color: #f0f4f8;
    width: 1fr;
}

.assistant-row {
    height: auto;
    margin-bottom: 1;
}

.bullet {
    width: 2;
    color: #7dd3fc;
    padding: 1 0 0 0;
}

.notice {
    color: #94a3b8;
}

.notice.error, .failed {
    color: #fb7185;
}

.notice.warning, .running {
    color: #fbbf24;
}

.context-boundary {
    color: #c4b5fd;
    text-align: center;
}

.succeeded {
    color: #34d399;
}

.tool-title {
    height: 1;
    color: #d7dde5;
}

.tool-body-wrap {
    height: auto;
}

.tool-body {
    padding: 0 1 0 2;
    color: #8b98ab;
}

.error-output {
    color: #fb7185;
}

.diff-removed {
    padding: 0 1;
    background: #2e1a1e;
    color: #f0f4f8;
}

.diff-added {
    padding: 0 1;
    background: #182a1d;
    color: #f0f4f8;
}

.diff-more {
    padding: 0 1 0 2;
    color: #6b7a8d;
    text-style: italic;
}

.thinking-title {
    height: 1;
    padding: 0 1;
    color: #8b98ab;
}

.thinking-body {
    padding: 0 1 0 3;
    color: #6b7a8d;
    text-style: italic;
    height: auto;
    max-height: 3;
    overflow: hidden;
}

.thinking-body.expanded {
    height: auto;
    max-height: 30;
    overflow-y: auto;
}

#status-bar {
    height: 3;
    padding: 0 1;
    background: #111821;
    border-top: solid #243244;
}

#status-bar Label {
    width: 1fr;
    padding: 1;
    color: #94a3b8;
}

#status-bar #status-mode {
    width: auto;
    padding: 1 6 1 1;
    color: #94a3b8;
}

#status-model {
    color: #7dd3fc;
}

#completion-popup {
    display: none;
    height: auto;
    max-height: 10;
    margin: 0 1;
    background: #111821;
    border: round #3b82f6;
}

#completion-title {
    height: 1;
    padding: 0 1;
    color: #7dd3fc;
    text-style: bold;
}

#completion-options {
    height: 1fr;
    background: #111821;
    border: none;
}

#composer {
    height: 3;
    min-height: 3;
    max-height: 8;
    margin: 0 1 1 1;
    border: tall #3b82f6;
    background: #111821;
}

#composer:focus {
    border: tall #7dd3fc;
}

Footer {
    background: #0b0f14;
    color: #64748b;
}

ResumeSessionScreen {
    background: #0b0f14;
    color: #d7dde5;
    layout: vertical;
    padding: 1 2;
}

#resume-title {
    height: 3;
    padding: 1 1;
    color: #7dd3fc;
    text-style: bold;
    border-bottom: solid #243244;
}

#resume-options {
    height: 1fr;
    margin-top: 1;
    background: #111821;
    border: round #334155;
}

#resume-preview {
    height: 9;
    padding: 1 2;
    margin-top: 1;
    background: #0f1720;
    color: #b6c2d1;
    border: round #334155;
}

#resume-help {
    height: 2;
    padding: 0 1;
    color: #64748b;
}

ApprovalScreen {
    align: center bottom;
    background: rgba(11, 15, 20, 0.45);
    color: #d7dde5;
}

#approval-dialog {
    width: 100%;
    max-width: 100%;
    min-width: 30;
    height: auto;
    max-height: 90%;
    background: #0b0f14;
    border-top: round #fbbf24;
    border-bottom: round #fbbf24;
    padding: 0 2 1 2;
}

#approval-title {
    height: 1;
    color: #fbbf24;
    text-style: bold;
    border-bottom: solid #854d0e;
}

#approval-details {
    height: auto;
    max-height: 8;
    padding: 1 1;
    background: #111821;
    border: round #334155;
}

#approval-options {
    height: 5;
    margin-top: 1;
    background: #111821;
    border: round #fbbf24;
}

#approval-help {
    height: 1;
    padding: 0 1;
    color: #94a3b8;
}
